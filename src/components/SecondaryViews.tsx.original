      const deliveryBatchHtml = `<!DOCTYPE html><html><head><meta charset="utf-8">
<style>
  @page { size: ${pageSizeCss}; margin: ${pageMarginCss}; }
  * { box-sizing: border-box; }
  body { font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; font-size: ${is58 ? '11' : isMediaCarta ? '14' : '13'}px; font-weight: 700; width: 100%; margin: 0; padding: 2mm calc(${sidePad} - ${offset}px) 2mm calc(${sidePad} + ${offset}px); color: #000; background: #fff; }
